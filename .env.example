# =============================================================================
# ResQPet AI - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=ResQPet AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
WS_BASE_URL=ws://localhost:8000
FRONTEND_URL=http://localhost:3000

# Tunnel URL for exposing local backend to Vapi (ngrok, cloudflared, etc.)
# Only needed if testing Vapi voice calls
# PUBLIC_API_URL=https://your-tunnel-url.ngrok.io

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://animalcare:animalcare_dev_password@localhost:5432/animalcare_db

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
APP_SECRET_KEY=

# JWT settings
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# PII encryption key (for sensitive data at rest)
# Generate with: openssl rand -hex 32
PII_ENCRYPTION_KEY=

# Phone number hashing salt
# Generate with: openssl rand -hex 32
PHONE_HASH_SALT=

# -----------------------------------------------------------------------------
# Vapi AI Voice Assistant
# -----------------------------------------------------------------------------
# Get from: https://vapi.ai
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=

# Vapi tool endpoint authentication secret
# This is sent by Vapi in the Authorization header when calling your tools
# Generate with: openssl rand -hex 32
VAPI_TOOL_SECRET=

# -----------------------------------------------------------------------------
# External Services (Optional - for future features)
# -----------------------------------------------------------------------------
# OpenAI (for AI-powered features beyond Vapi)
# OPENAI_API_KEY=your-openai-api-key-here

# AWS S3 (for media storage)
# AWS_ACCESS_KEY_ID=your-aws-access-key-here
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=animalcare-media

# Google Maps API (for location services)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Twilio (for SMS notifications)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
# TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
# TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------------------
# Admin Bootstrap
# Optional extra demo roles: set private passwords before running the seed script.
DEMO_OWNER_PASSWORD=
DEMO_VET_PASSWORD=
# -----------------------------------------------------------------------------
# These credentials will be used to create the first admin user
# IMPORTANT: Change these before first run
ADMIN_BOOTSTRAP_EMAIL=admin@resqpet.ai
ADMIN_BOOTSTRAP_PASSWORD=

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# -----------------------------------------------------------------------------
# File Upload Limits
# -----------------------------------------------------------------------------
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=30
MAX_AUDIO_SIZE_MB=10

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
# Use a separate database for tests
TEST_DATABASE_URL=postgresql://animalcare:animalcare_dev_password@localhost:5432/animalcare_test_db

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_VETERINARY_CONSULTATIONS=false
ENABLE_ADOPTION_SYSTEM=false
ENABLE_REPRODUCTIVE_HEALTH=false
ENABLE_ML_TRIAGE_MODEL=false

# -----------------------------------------------------------------------------
# Monitoring & Logging (Optional)
# -----------------------------------------------------------------------------
# SENTRY_DSN=your-sentry-dsn-here
# SENTRY_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# CORS Settings
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# -----------------------------------------------------------------------------
# WebSocket
# -----------------------------------------------------------------------------
WS_HEARTBEAT_INTERVAL=30
WS_CONNECTION_TIMEOUT=300
